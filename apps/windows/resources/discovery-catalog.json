    {
      "name": "workspace.git_worktree_action",
      "kind": "git",
      "label": "Git worktree lifecycle",
      "permission": "workspace.git",
      "risk": "medium",
      "description": "Remove, prune, lock, or unlock a Git worktree.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "remove",
              "prune",
              "lock",
              "unlock"
            ]
          },
          "path": {
            "type": "string"
          },
          "force": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "expire": {
            "type": "string"
          }
        },
        "required": [
          "workspaceId",
          "action"

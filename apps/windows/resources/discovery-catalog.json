      "outputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "worktrees": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "toolRunId": {
            "type": "string"
          }
        }
      }
